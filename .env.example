# KC Technology Corporation — environment template
# Copy to `.env.local` for development and fill in real values.
# NEVER commit real credentials. This file contains safe placeholders only.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ---------------------------------------------------------------------------
# Supabase (public values are safe to expose; secret/service key is server-only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"

# Salt for hashing inquiry submitter IPs. Changing it invalidates existing hashes.
INQUIRY_IP_SALT="server-only-random-salt"

# ---------------------------------------------------------------------------
# Tolgee (localization runtime + server-side management)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TOLGEE_API_URL="https://app.tolgee.io"
NEXT_PUBLIC_TOLGEE_PROJECT_ID=""
TOLGEE_API_KEY="server-only-tolgee-management-api-key"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY="server-only-resend-api-key"
EMAIL_FROM="no-reply@example.com"
EMAIL_CONTACT_TO="kctechc@gmail.com"

# ---------------------------------------------------------------------------
# Analytics (consent-aware; never send PII)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Maps (adapter-based; MapLibre + OpenFreeMap is the default stack)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER="openfreemap"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---------------------------------------------------------------------------
# Orders (no payment provider).
#
# The site takes NO payment itself. A customer's chosen method is recorded as an
# *intent*, the order is emailed to the business, and the team contacts the
# customer to finalise payment (mobile money, bank transfer, or as agreed).
#
# ORDERS_NOTIFY_TO is the shared mailbox that receives new-order notifications.
# Leave it blank to send them to every public contact address in
# `src/lib/config/site.ts` (SITE.emails).
# ---------------------------------------------------------------------------
ORDERS_NOTIFY_TO=""

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Bot verification (Cloudflare Turnstile or an hCaptcha-compatible endpoint).
# Both must be set to enable the check; when either is blank the server-side
# verification step is skipped, which is the correct behaviour for local
# development. Never rely on a client-only widget: `verifySubmission` re-checks
# the token server-side against this endpoint before any write.
BOT_VERIFICATION_SECRET_KEY="server-only-bot-verification-secret"
BOT_VERIFICATION_ENDPOINT="https://challenges.cloudflare.com/turnstile/v0/siteverify"

# Rate limiting. The current limiter is in-process and dependency-free
# (`src/lib/security/rate-limit.ts`), so nothing reads these yet. They are the
# seam for the shared store that replaces it when the app runs on more than one
# instance, where a per-instance window would let a distributed caller past the
# limit. Set both to switch the limiter to a shared backend.
RATE_LIMIT_PROVIDER_URL=""
RATE_LIMIT_API_KEY=""
