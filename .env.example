# KC Technology Corporation — environment template
# Copy to `.env.local` for development and fill in real values.
# NEVER commit real credentials. This file contains safe placeholders only.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://example.com"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ---------------------------------------------------------------------------
# Supabase (public values are safe to expose; secret/service key is server-only)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
# Server-only. Use the legacy service_role JWT or the newer sb_secret_… key.
# The app reads SUPABASE_SERVICE_ROLE_KEY first and SUPABASE_SECRET_KEY second.
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
# SUPABASE_SECRET_KEY="sb_secret_..."

# Salt for hashing inquiry submitter IPs. Changing it invalidates existing hashes.
INQUIRY_IP_SALT="server-only-random-salt"

# ---------------------------------------------------------------------------
# Social sign-in (Supabase OAuth + Google Identity Services)
# ---------------------------------------------------------------------------
# Comma-separated list of providers to OFFER on /login and /sign-up.
# Supported: google, facebook. Both are offered when this variable is unset or
# blank; set it to `none` (or any value naming no supported provider) to hide
# every social button -- the honest state for a deployment whose providers are
# not enabled in the Supabase dashboard, because Supabase then shows a raw
# "provider is not enabled" dead end the visitor cannot act on).
#
# Provider secrets are NOT set here. They live in the Supabase dashboard
# (Authentication -> Providers) and never reach this app or the browser. The
# Google client ID is the exception: it is public and the browser needs it, so
# it is set below as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
#
# Google uses Google Identity Services (`signInWithIdToken`) when
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is set: the browser obtains a Google ID token
# directly from Google and hands it to Supabase, so Google's consent screen shows
# this site's verified domain and brand name from the Google Cloud project rather
# than the `<project-ref>.supabase.co` host. Without that client id the Google
# button falls back to the Supabase OAuth redirect, so it is still displayed and
# functional -- it just names the Supabase host on the consent screen.
#
# Turning a provider on takes these steps:
#   1. Supabase dashboard -> Authentication -> Providers -> enable the provider
#      and paste its client id/secret.
#   2. Add the redirect URL to Authentication -> URL Configuration ->
#      Redirect URLs: https://your-domain/auth/callback
#   3. List the provider below and rebuild (this is a NEXT_PUBLIC_ value, so it
#      is inlined at build time and a running server will not pick it up).
#   4. For the verified-domain Google consent screen, set
#      NEXT_PUBLIC_GOOGLE_CLIENT_ID to the SAME client id as the Supabase Google
#      provider, and add every site origin to that client's Authorized
#      JavaScript origins in Google Cloud Console. Without it, Google still
#      appears through the Supabase redirect fallback.
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS="google,facebook"

# Google Identity Services client ID (public). Must match the client ID in
# Supabase's Google provider. The client secret stays in Supabase.
# Use the SAME Google OAuth client that is already in Supabase's Google
# provider; do not create a second Google Cloud OAuth client.
# Leave this blank to use the Supabase Google OAuth redirect fallback (the
# Google button still appears, but the consent screen names the Supabase host).
# Set it to enable the verified-domain GIS button. It is inlined at build time,
# so set it before building; a running standalone server will not pick it up.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ---------------------------------------------------------------------------
# Tolgee (localization runtime + server-side management)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TOLGEE_API_URL="https://app.tolgee.io"
NEXT_PUBLIC_TOLGEE_PROJECT_ID=""
TOLGEE_API_KEY="server-only-tolgee-management-api-key"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY="server-only-resend-api-key"
EMAIL_FROM="no-reply@example.com"
EMAIL_CONTACT_TO="kctechc@gmail.com"

# ---------------------------------------------------------------------------
# Analytics (consent-aware; never send PII)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ---------------------------------------------------------------------------
# Maps (adapter-based; MapLibre + OpenFreeMap is the default stack)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER="openfreemap"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---------------------------------------------------------------------------
# Orders (no payment provider).
#
# The site takes NO payment itself. A customer's chosen method is recorded as an
# *intent*, the order is emailed to the business, and the team contacts the
# customer to finalise payment (mobile money, bank transfer, or as agreed).
#
# ORDERS_NOTIFY_TO is the shared mailbox that receives new-order notifications.
# Leave it blank to send them to every public contact address in
# `src/lib/config/site.ts` (SITE.emails).
# ---------------------------------------------------------------------------
ORDERS_NOTIFY_TO=""

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Bot verification (Cloudflare Turnstile or an hCaptcha-compatible endpoint).
# Both must be set to enable the check; when either is blank the server-side
# verification step is skipped, which is the correct behaviour for local
# development. Never rely on a client-only widget: `verifySubmission` re-checks
# the token server-side against this endpoint before any write.
BOT_VERIFICATION_SECRET_KEY="server-only-bot-verification-secret"
BOT_VERIFICATION_ENDPOINT="https://challenges.cloudflare.com/turnstile/v0/siteverify"

# Rate limiting. The current limiter is in-process and dependency-free
# (`src/lib/security/rate-limit.ts`), so nothing reads these yet. They are the
# seam for the shared store that replaces it when the app runs on more than one
# instance, where a per-instance window would let a distributed caller past the
# limit. Set both to switch the limiter to a shared backend.
RATE_LIMIT_PROVIDER_URL=""
RATE_LIMIT_API_KEY=""
